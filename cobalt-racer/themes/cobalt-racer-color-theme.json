  "tokenColors": [
    { "settings": { "foreground": "#f5f3ef", "background": "#171614" } },
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8a92a0", "fontStyle": "italic" } },
    { "name": "Punctuation", "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "punctuation.definition.block", "meta.brace"], "settings": { "foreground": "#8a92a0" } },
    { "name": "Delimiters / Brackets", "scope": ["punctuation.section", "punctuation.definition.tag"], "settings": { "foreground": "#8a92a0" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "keyword.other", "storage.type", "storage.modifier"], "settings": { "foreground": "#5a4fd4", "fontStyle": "bold" } },
    { "name": "Control Flow", "scope": ["keyword.control.flow", "keyword.control.conditional", "keyword.control.loop", "keyword.control.import", "keyword.control.from"], "settings": { "foreground": "#3a327a", "fontStyle": "bold" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#d4d0c8" } },
    { "name": "Strings", "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#e8b93a" } },
    { "name": "String Escapes / Interpolation", "scope": ["constant.character.escape", "punctuation.definition.template-expression", "punctuation.section.embedded"], "settings": { "foreground": "#7a8fd0" } },
    { "name": "Numbers / Booleans / Constants", "scope": ["constant.numeric", "constant.language", "constant.language.boolean", "variable.language.this", "support.constant"], "settings": { "foreground": "#7a8fd0" } },
    { "name": "Functions / Methods", "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"], "settings": { "foreground": "#4fb8e8" } },
    { "name": "Classes / Types / Interfaces", "scope": ["entity.name.class", "entity.name.type", "entity.other.inherited-class", "support.class", "support.type"], "settings": { "foreground": "#f5d572", "fontStyle": "bold" } },
    { "name": "Variables", "scope": ["variable", "variable.other.readwrite"], "settings": { "foreground": "#f5f3ef" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#d4d0c8", "fontStyle": "italic" } },
    { "name": "Properties / Attributes", "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"], "settings": { "foreground": "#8fdcff" } },
    { "name": "Tags (HTML/JSX/XML)", "scope": ["entity.name.tag", "meta.tag"], "settings": { "foreground": "#5a4fd4" } },
    { "name": "Tag Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#e8b93a", "fontStyle": "italic" } },
    { "name": "Decorators / Annotations", "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"], "settings": { "foreground": "#e8b93a", "fontStyle": "italic" } },
    { "name": "Regex", "scope": ["string.regexp"], "settings": { "foreground": "#5aa8c8" } },
    { "name": "CSS Property Names", "scope": ["support.type.property-name.css", "meta.property-name.css"], "settings": { "foreground": "#8fdcff" } },
    { "name": "CSS Values / Units", "scope": ["support.constant.property-value.css", "constant.numeric.css"], "settings": { "foreground": "#7a8fd0" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#171614", "background": "#5a4fd4" } },
    { "name": "Deprecated", "scope": ["invalid.deprecated"], "settings": { "foreground": "#8a92a0", "fontStyle": "strikethrough" } },
    { "name": "Markup Headings", "scope": ["markup.heading", "entity.name.section.markdown"], "settings": { "foreground": "#5a4fd4", "fontStyle": "bold" } },
    { "name": "Markup Bold", "scope": ["markup.bold"], "settings": { "foreground": "#ffffff", "fontStyle": "bold" } },
    { "name": "Markup Italic", "scope": ["markup.italic"], "settings": { "foreground": "#f5f3ef", "fontStyle": "italic" } },
    { "name": "Markup Links", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#7a8fd0", "fontStyle": "underline" } },
    { "name": "Markup Quote", "scope": ["markup.quote"], "settings": { "foreground": "#8aab7f", "fontStyle": "italic" } },
    { "name": "Markup Raw / Code", "scope": ["markup.raw", "markup.inline.raw"], "settings": { "foreground": "#e8b93a" } },
    { "name": "Markup List", "scope": ["markup.list", "punctuation.definition.list.begin.markdown"], "settings": { "foreground": "#e8b93a" } },
    { "name": "Diff Inserted", "scope": ["markup.inserted"], "settings": { "foreground": "#8aab7f" } },
    { "name": "Diff Deleted", "scope": ["markup.deleted"], "settings": { "foreground": "#5a4fd4" } },
    { "name": "Diff Changed", "scope": ["markup.changed"], "settings": { "foreground": "#e8b93a" } },
    { "name": "JSON Keys", "scope": ["support.type.property-name.json"], "settings": { "foreground": "#8fdcff" } },
    { "name": "YAML Keys", "scope": ["entity.name.tag.yaml"], "settings": { "foreground": "#8fdcff" } }
  ]
}
