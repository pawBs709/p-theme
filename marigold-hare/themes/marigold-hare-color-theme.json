  "tokenColors": [
    { "settings": { "foreground": "#f7e8d8", "background": "#1a0e10" } },
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8a6f5c", "fontStyle": "italic" } },
    { "name": "Punctuation", "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "punctuation.definition.block", "meta.brace"], "settings": { "foreground": "#8a6f5c" } },
    { "name": "Delimiters / Brackets", "scope": ["punctuation.section", "punctuation.definition.tag"], "settings": { "foreground": "#8a6f5c" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "keyword.other", "storage.type", "storage.modifier"], "settings": { "foreground": "#ff4da6", "fontStyle": "bold" } },
    { "name": "Control Flow", "scope": ["keyword.control.flow", "keyword.control.conditional", "keyword.control.loop", "keyword.control.import", "keyword.control.from"], "settings": { "foreground": "#b8306f", "fontStyle": "bold" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#ddc7b0" } },
    { "name": "Strings", "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#f0b429" } },
    { "name": "String Escapes / Interpolation", "scope": ["constant.character.escape", "punctuation.definition.template-expression", "punctuation.section.embedded"], "settings": { "foreground": "#4aa8e8" } },
    { "name": "Numbers / Booleans / Constants", "scope": ["constant.numeric", "constant.language", "constant.language.boolean", "variable.language.this", "support.constant"], "settings": { "foreground": "#4aa8e8" } },
    { "name": "Functions / Methods", "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"], "settings": { "foreground": "#e6432f" } },
    { "name": "Classes / Types / Interfaces", "scope": ["entity.name.class", "entity.name.type", "entity.other.inherited-class", "support.class", "support.type"], "settings": { "foreground": "#ffd666", "fontStyle": "bold" } },
    { "name": "Variables", "scope": ["variable", "variable.other.readwrite"], "settings": { "foreground": "#f7e8d8" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#ddc7b0", "fontStyle": "italic" } },
    { "name": "Properties / Attributes", "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"], "settings": { "foreground": "#ff7a63" } },
    { "name": "Tags (HTML/JSX/XML)", "scope": ["entity.name.tag", "meta.tag"], "settings": { "foreground": "#ff4da6" } },
    { "name": "Tag Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#f0b429", "fontStyle": "italic" } },
    { "name": "Decorators / Annotations", "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"], "settings": { "foreground": "#f0b429", "fontStyle": "italic" } },
    { "name": "Regex", "scope": ["string.regexp"], "settings": { "foreground": "#5fb0a8" } },
    { "name": "CSS Property Names", "scope": ["support.type.property-name.css", "meta.property-name.css"], "settings": { "foreground": "#ff7a63" } },
    { "name": "CSS Values / Units", "scope": ["support.constant.property-value.css", "constant.numeric.css"], "settings": { "foreground": "#4aa8e8" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#1a0e10", "background": "#ff4da6" } },
    { "name": "Deprecated", "scope": ["invalid.deprecated"], "settings": { "foreground": "#8a6f5c", "fontStyle": "strikethrough" } },
    { "name": "Markup Headings", "scope": ["markup.heading", "entity.name.section.markdown"], "settings": { "foreground": "#ff4da6", "fontStyle": "bold" } },
    { "name": "Markup Bold", "scope": ["markup.bold"], "settings": { "foreground": "#fff8ef", "fontStyle": "bold" } },
    { "name": "Markup Italic", "scope": ["markup.italic"], "settings": { "foreground": "#f7e8d8", "fontStyle": "italic" } },
    { "name": "Markup Links", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#4aa8e8", "fontStyle": "underline" } },
    { "name": "Markup Quote", "scope": ["markup.quote"], "settings": { "foreground": "#7ea86a", "fontStyle": "italic" } },
    { "name": "Markup Raw / Code", "scope": ["markup.raw", "markup.inline.raw"], "settings": { "foreground": "#f0b429" } },
    { "name": "Markup List", "scope": ["markup.list", "punctuation.definition.list.begin.markdown"], "settings": { "foreground": "#f0b429" } },
    { "name": "Diff Inserted", "scope": ["markup.inserted"], "settings": { "foreground": "#7ea86a" } },
    { "name": "Diff Deleted", "scope": ["markup.deleted"], "settings": { "foreground": "#ff4da6" } },
    { "name": "Diff Changed", "scope": ["markup.changed"], "settings": { "foreground": "#f0b429" } },
    { "name": "JSON Keys", "scope": ["support.type.property-name.json"], "settings": { "foreground": "#ff7a63" } },
    { "name": "YAML Keys", "scope": ["entity.name.tag.yaml"], "settings": { "foreground": "#ff7a63" } }
  ]
}
