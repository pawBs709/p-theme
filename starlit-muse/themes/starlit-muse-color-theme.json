  "tokenColors": [
    {
      "settings": {
        "foreground": "#e8e5f2",
        "background": "#0d1023"
      }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#8890b8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.block",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#9a96b8"
      }
    },
    {
      "name": "Delimiters / Brackets",
      "scope": ["punctuation.section", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#8a8fb0"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#a68fd6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Flow",
      "scope": [
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.import",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#8a6fc0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#8fa3c4"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#d3b06a"
      }
    },
    {
      "name": "String Escapes / Interpolation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#7ec4e8"
      }
    },
    {
      "name": "Numbers / Booleans / Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "variable.language.this",
        "support.constant"
      ],
      "settings": {
        "foreground": "#7ec4e8"
      }
    },
    {
      "name": "Functions / Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#8ecdeb"
      }
    },
    {
      "name": "Classes / Types / Interfaces",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#e0c080",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other.readwrite"],
      "settings": {
        "foreground": "#dcd9ea"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#c9c5d6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties / Attributes",
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": {
        "foreground": "#c9b8e0"
      }
    },
    {
      "name": "Tags (HTML/JSX/XML)",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#a68fd6"
      }
    },
    {
      "name": "Tag Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#d3b06a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorators / Annotations",
      "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
      "settings": {
        "foreground": "#d3b06a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#8fd6d0"
      }
    },
    {
      "name": "CSS Property Names",
      "scope": ["support.type.property-name.css", "meta.property-name.css"],
      "settings": {
        "foreground": "#c9b8e0"
      }
    },
    {
      "name": "CSS Values / Units",
      "scope": ["support.constant.property-value.css", "constant.numeric.css"],
      "settings": {
        "foreground": "#7ec4e8"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#f2f0f8",
        "background": "#d47a8a"
      }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#d47a8a",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup Headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": {
        "foreground": "#a68fd6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#f2f0f8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#dcd9ea",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup Links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#7ec4e8",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup Quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#8fbf9f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup Raw / Code",
      "scope": ["markup.raw", "markup.inline.raw"],
      "settings": {
        "foreground": "#d3b06a"
      }
    },
    {
      "name": "Markup List",
      "scope": ["markup.list", "punctuation.definition.list.begin.markdown"],
      "settings": {
        "foreground": "#d3b06a"
      }
    },
    {
      "name": "Diff Inserted",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#8fbf9f"
      }
    },
    {
      "name": "Diff Deleted",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#d47a8a"
      }
    },
    {
      "name": "Diff Changed",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#d3b06a"
      }
    },
    {
      "name": "JSON Keys",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#c9b8e0"
      }
    },
    {
      "name": "YAML Keys",
      "scope": ["entity.name.tag.yaml"],
      "settings": {
        "foreground": "#c9b8e0"
      }
    }
  ]
}
