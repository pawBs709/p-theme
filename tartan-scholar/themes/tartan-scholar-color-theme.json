  "tokenColors": [
    { "settings": { "foreground": "#e6ece6", "background": "#131c18" } },
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8a849e", "fontStyle": "italic" } },
    { "name": "Punctuation", "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "punctuation.definition.block", "meta.brace"], "settings": { "foreground": "#8f9f96" } },
    { "name": "Delimiters / Brackets", "scope": ["punctuation.section", "punctuation.definition.tag"], "settings": { "foreground": "#8a849e" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "keyword.other", "storage.type", "storage.modifier"], "settings": { "foreground": "#e8d03c", "fontStyle": "bold" } },
    { "name": "Control Flow", "scope": ["keyword.control.flow", "keyword.control.conditional", "keyword.control.loop", "keyword.control.import", "keyword.control.from"], "settings": { "foreground": "#8c7a14", "fontStyle": "bold" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#bcc7bf" } },
    { "name": "Strings", "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#d9a85c" } },
    { "name": "String Escapes / Interpolation", "scope": ["constant.character.escape", "punctuation.definition.template-expression", "punctuation.section.embedded"], "settings": { "foreground": "#a3a8e8" } },
    { "name": "Numbers / Booleans / Constants", "scope": ["constant.numeric", "constant.language", "constant.language.boolean", "variable.language.this", "support.constant"], "settings": { "foreground": "#a3a8e8" } },
    { "name": "Functions / Methods", "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"], "settings": { "foreground": "#4cb2ec" } },
    { "name": "Classes / Types / Interfaces", "scope": ["entity.name.class", "entity.name.type", "entity.other.inherited-class", "support.class", "support.type"], "settings": { "foreground": "#ecc890", "fontStyle": "bold" } },
    { "name": "Variables", "scope": ["variable", "variable.other.readwrite"], "settings": { "foreground": "#e6ece6" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#bcc7bf", "fontStyle": "italic" } },
    { "name": "Properties / Attributes", "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"], "settings": { "foreground": "#8fd0f5" } },
    { "name": "Tags (HTML/JSX/XML)", "scope": ["entity.name.tag", "meta.tag"], "settings": { "foreground": "#e8d03c" } },
    { "name": "Tag Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#d9a85c", "fontStyle": "italic" } },
    { "name": "Decorators / Annotations", "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"], "settings": { "foreground": "#d9a85c", "fontStyle": "italic" } },
    { "name": "Regex", "scope": ["string.regexp"], "settings": { "foreground": "#6fcfc0" } },
    { "name": "CSS Property Names", "scope": ["support.type.property-name.css", "meta.property-name.css"], "settings": { "foreground": "#8fd0f5" } },
    { "name": "CSS Values / Units", "scope": ["support.constant.property-value.css", "constant.numeric.css"], "settings": { "foreground": "#a3a8e8" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#131c18", "background": "#e8d03c" } },
    { "name": "Deprecated", "scope": ["invalid.deprecated"], "settings": { "foreground": "#8a849e", "fontStyle": "strikethrough" } },
    { "name": "Markup Headings", "scope": ["markup.heading", "entity.name.section.markdown"], "settings": { "foreground": "#e8d03c", "fontStyle": "bold" } },
    { "name": "Markup Bold", "scope": ["markup.bold"], "settings": { "foreground": "#f8fbf8", "fontStyle": "bold" } },
    { "name": "Markup Italic", "scope": ["markup.italic"], "settings": { "foreground": "#e6ece6", "fontStyle": "italic" } },
    { "name": "Markup Links", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#a3a8e8", "fontStyle": "underline" } },
    { "name": "Markup Quote", "scope": ["markup.quote"], "settings": { "foreground": "#6fbf8a", "fontStyle": "italic" } },
    { "name": "Markup Raw / Code", "scope": ["markup.raw", "markup.inline.raw"], "settings": { "foreground": "#d9a85c" } },
    { "name": "Markup List", "scope": ["markup.list", "punctuation.definition.list.begin.markdown"], "settings": { "foreground": "#d9a85c" } },
    { "name": "Diff Inserted", "scope": ["markup.inserted"], "settings": { "foreground": "#6fbf8a" } },
    { "name": "Diff Deleted", "scope": ["markup.deleted"], "settings": { "foreground": "#e8d03c" } },
    { "name": "Diff Changed", "scope": ["markup.changed"], "settings": { "foreground": "#d9a85c" } },
    { "name": "JSON Keys", "scope": ["support.type.property-name.json"], "settings": { "foreground": "#8fd0f5" } },
    { "name": "YAML Keys", "scope": ["entity.name.tag.yaml"], "settings": { "foreground": "#8fd0f5" } }
  ]
}
