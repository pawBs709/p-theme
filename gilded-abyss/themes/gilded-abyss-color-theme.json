  "tokenColors": [
    { "settings": { "foreground": "#f0e8e0", "background": "#120e18" } },
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6a5c85", "fontStyle": "italic" } },
    { "name": "Punctuation", "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "punctuation.definition.block", "meta.brace"], "settings": { "foreground": "#7a6a99" } },
    { "name": "Delimiters / Brackets", "scope": ["punctuation.section", "punctuation.definition.tag"], "settings": { "foreground": "#6a5c85" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "keyword.other", "storage.type", "storage.modifier"], "settings": { "foreground": "#e8942e", "fontStyle": "bold" } },
    { "name": "Control Flow", "scope": ["keyword.control.flow", "keyword.control.conditional", "keyword.control.loop", "keyword.control.import", "keyword.control.from"], "settings": { "foreground": "#b3701c", "fontStyle": "bold" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#cdbfe0" } },
    { "name": "Strings", "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#c23b3b" } },
    { "name": "String Escapes / Interpolation", "scope": ["constant.character.escape", "punctuation.definition.template-expression", "punctuation.section.embedded"], "settings": { "foreground": "#6b8fc2" } },
    { "name": "Numbers / Booleans / Constants", "scope": ["constant.numeric", "constant.language", "constant.language.boolean", "variable.language.this", "support.constant"], "settings": { "foreground": "#6b8fc2" } },
    { "name": "Functions / Methods", "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"], "settings": { "foreground": "#6b4e94" } },
    { "name": "Classes / Types / Interfaces", "scope": ["entity.name.class", "entity.name.type", "entity.other.inherited-class", "support.class", "support.type"], "settings": { "foreground": "#e07070", "fontStyle": "bold" } },
    { "name": "Variables", "scope": ["variable", "variable.other.readwrite"], "settings": { "foreground": "#f0e8e0" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#cdbfe0", "fontStyle": "italic" } },
    { "name": "Properties / Attributes", "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"], "settings": { "foreground": "#9a7cc4" } },
    { "name": "Tags (HTML/JSX/XML)", "scope": ["entity.name.tag", "meta.tag"], "settings": { "foreground": "#e8942e" } },
    { "name": "Tag Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#c23b3b", "fontStyle": "italic" } },
    { "name": "Decorators / Annotations", "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"], "settings": { "foreground": "#c23b3b", "fontStyle": "italic" } },
    { "name": "Regex", "scope": ["string.regexp"], "settings": { "foreground": "#6ea8b0" } },
    { "name": "CSS Property Names", "scope": ["support.type.property-name.css", "meta.property-name.css"], "settings": { "foreground": "#9a7cc4" } },
    { "name": "CSS Values / Units", "scope": ["support.constant.property-value.css", "constant.numeric.css"], "settings": { "foreground": "#6b8fc2" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#120e18", "background": "#e8942e" } },
    { "name": "Deprecated", "scope": ["invalid.deprecated"], "settings": { "foreground": "#6a5c85", "fontStyle": "strikethrough" } },
    { "name": "Markup Headings", "scope": ["markup.heading", "entity.name.section.markdown"], "settings": { "foreground": "#e8942e", "fontStyle": "bold" } },
    { "name": "Markup Bold", "scope": ["markup.bold"], "settings": { "foreground": "#fbf8f5", "fontStyle": "bold" } },
    { "name": "Markup Italic", "scope": ["markup.italic"], "settings": { "foreground": "#f0e8e0", "fontStyle": "italic" } },
    { "name": "Markup Links", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#6b8fc2", "fontStyle": "underline" } },
    { "name": "Markup Quote", "scope": ["markup.quote"], "settings": { "foreground": "#8aa66b", "fontStyle": "italic" } },
    { "name": "Markup Raw / Code", "scope": ["markup.raw", "markup.inline.raw"], "settings": { "foreground": "#c23b3b" } },
    { "name": "Markup List", "scope": ["markup.list", "punctuation.definition.list.begin.markdown"], "settings": { "foreground": "#c23b3b" } },
    { "name": "Diff Inserted", "scope": ["markup.inserted"], "settings": { "foreground": "#8aa66b" } },
    { "name": "Diff Deleted", "scope": ["markup.deleted"], "settings": { "foreground": "#e8942e" } },
    { "name": "Diff Changed", "scope": ["markup.changed"], "settings": { "foreground": "#c23b3b" } },
    { "name": "JSON Keys", "scope": ["support.type.property-name.json"], "settings": { "foreground": "#9a7cc4" } },
    { "name": "YAML Keys", "scope": ["entity.name.tag.yaml"], "settings": { "foreground": "#9a7cc4" } }
  ]
}
