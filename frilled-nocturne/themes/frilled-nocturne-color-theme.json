  "tokenColors": [
    { "settings": { "foreground": "#ece2ee", "background": "#18152a" } },
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7d7299", "fontStyle": "italic" } },
    { "name": "Punctuation", "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "punctuation.definition.block", "meta.brace"], "settings": { "foreground": "#9a8fb0" } },
    { "name": "Delimiters / Brackets", "scope": ["punctuation.section", "punctuation.definition.tag"], "settings": { "foreground": "#7d7299" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "keyword.other", "storage.type", "storage.modifier"], "settings": { "foreground": "#f59ad0", "fontStyle": "bold" } },
    { "name": "Control Flow", "scope": ["keyword.control.flow", "keyword.control.conditional", "keyword.control.loop", "keyword.control.import", "keyword.control.from"], "settings": { "foreground": "#b8568f", "fontStyle": "bold" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#bfb3c8" } },
    { "name": "Strings", "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#f5b04a" } },
    { "name": "String Escapes / Interpolation", "scope": ["constant.character.escape", "punctuation.definition.template-expression", "punctuation.section.embedded"], "settings": { "foreground": "#8fb4f0" } },
    { "name": "Numbers / Booleans / Constants", "scope": ["constant.numeric", "constant.language", "constant.language.boolean", "variable.language.this", "support.constant"], "settings": { "foreground": "#8fb4f0" } },
    { "name": "Functions / Methods", "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"], "settings": { "foreground": "#c4b5f0" } },
    { "name": "Classes / Types / Interfaces", "scope": ["entity.name.class", "entity.name.type", "entity.other.inherited-class", "support.class", "support.type"], "settings": { "foreground": "#ffd08a", "fontStyle": "bold" } },
    { "name": "Variables", "scope": ["variable", "variable.other.readwrite"], "settings": { "foreground": "#ece2ee" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#bfb3c8", "fontStyle": "italic" } },
    { "name": "Properties / Attributes", "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"], "settings": { "foreground": "#ddd2ff" } },
    { "name": "Tags (HTML/JSX/XML)", "scope": ["entity.name.tag", "meta.tag"], "settings": { "foreground": "#f59ad0" } },
    { "name": "Tag Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#f5b04a", "fontStyle": "italic" } },
    { "name": "Decorators / Annotations", "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"], "settings": { "foreground": "#f5b04a", "fontStyle": "italic" } },
    { "name": "Regex", "scope": ["string.regexp"], "settings": { "foreground": "#8ed4d8" } },
    { "name": "CSS Property Names", "scope": ["support.type.property-name.css", "meta.property-name.css"], "settings": { "foreground": "#ddd2ff" } },
    { "name": "CSS Values / Units", "scope": ["support.constant.property-value.css", "constant.numeric.css"], "settings": { "foreground": "#8fb4f0" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#18152a", "background": "#f59ad0" } },
    { "name": "Deprecated", "scope": ["invalid.deprecated"], "settings": { "foreground": "#7d7299", "fontStyle": "strikethrough" } },
    { "name": "Markup Headings", "scope": ["markup.heading", "entity.name.section.markdown"], "settings": { "foreground": "#f59ad0", "fontStyle": "bold" } },
    { "name": "Markup Bold", "scope": ["markup.bold"], "settings": { "foreground": "#fff8fc", "fontStyle": "bold" } },
    { "name": "Markup Italic", "scope": ["markup.italic"], "settings": { "foreground": "#ece2ee", "fontStyle": "italic" } },
    { "name": "Markup Links", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#8fb4f0", "fontStyle": "underline" } },
    { "name": "Markup Quote", "scope": ["markup.quote"], "settings": { "foreground": "#9cc9a3", "fontStyle": "italic" } },
    { "name": "Markup Raw / Code", "scope": ["markup.raw", "markup.inline.raw"], "settings": { "foreground": "#f5b04a" } },
    { "name": "Markup List", "scope": ["markup.list", "punctuation.definition.list.begin.markdown"], "settings": { "foreground": "#f5b04a" } },
    { "name": "Diff Inserted", "scope": ["markup.inserted"], "settings": { "foreground": "#9cc9a3" } },
    { "name": "Diff Deleted", "scope": ["markup.deleted"], "settings": { "foreground": "#f59ad0" } },
    { "name": "Diff Changed", "scope": ["markup.changed"], "settings": { "foreground": "#f5b04a" } },
    { "name": "JSON Keys", "scope": ["support.type.property-name.json"], "settings": { "foreground": "#ddd2ff" } },
    { "name": "YAML Keys", "scope": ["entity.name.tag.yaml"], "settings": { "foreground": "#ddd2ff" } }
  ]
}
